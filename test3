<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D 治愈：极简星空卡皮巴拉</title>
    
    <!-- 引入 Three.js 库 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

    <style>
        /* 基础样式 */
        body { 
            margin: 0; padding: 0; overflow: hidden; 
            background: #1e0b36; 
            font-family: 'Segoe UI', 'PingFang SC', sans-serif; cursor: crosshair; 
        }
        #container { width: 100vw; height: 100vh; position: relative; display: none; } 
        
        /* 引入层：三图序列 */
        #intro-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: #fdf6f0; 
            z-index: 1000;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* 幻灯片样式 */
        .slide {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            opacity: 0;
            object-fit: cover;
            /* 关键：使用 transform 实现放大，opacity 实现淡入淡出 */
            transition: opacity 1.5s cubic-bezier(0.4, 0, 0.2, 1), transform 1.5s cubic-bezier(0.4, 0, 0.2, 1);
            transform: scale(1.0);
            pointer-events: none;
        }

        /* 活跃状态：图片出现且静止 */
        .slide.active {
            opacity: 1;
            transform: scale(1.0);
        }

        /* 退出状态：在切换时平滑放大并消失 */
        .slide.exit {
            opacity: 0;
            transform: scale(1.15);
        }

        /* 模式切换器 */
        #mode-selector {
            position: absolute;
            top: 25px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 2px solid rgba(212, 184, 152, 0.3);
            border-radius: 40px;
            padding: 6px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
            z-index: 200;
        }
        .mode-btn {
            padding: 10px 30px;
            border-radius: 35px;
            cursor: pointer;
            font-size: 15px;
            font-weight: bold;
            color: #f5e6d3;
            transition: all 0.4s ease;
            user-select: none;
        }
        .mode-btn.active {
            background: #d4b898;
            color: #1e0b36;
        }

        /* 操作指南 - 左下角 */
        #guide-panel {
            position: absolute;
            bottom: 30px;
            left: 30px;
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 18px 25px;
            border: 1px solid rgba(212, 184, 152, 0.2);
            color: #f5e6d3;
            z-index: 100;
            transition: opacity 0.5s;
            pointer-events: none;
        }
        .guide-title {
            font-size: 14px;
            font-weight: bold;
            color: #d4b898;
            margin-bottom: 10px;
        }
        .guide-item {
            font-size: 13px;
            margin: 6px 0;
            display: flex;
            align-items: center;
            gap: 8px;
            opacity: 0.9;
        }

        /* 游戏 UI */
        #game-ui {
            position: absolute;
            top: 100px;
            left: 0;
            width: 100%;
            display: none;
            justify-content: space-between;
            padding: 0 40px;
            box-sizing: border-box;
            z-index: 150;
        }
        .ui-item {
            background: rgba(255, 255, 255, 0.1);
            padding: 10px 20px;
            border-radius: 15px;
            color: #f5e6d3;
            font-weight: bold;
        }

        /* 遮罩通用 */
        .overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(30, 11, 54, 0.95);
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 300;
            text-align: center;
            color: #f5e6d3;
        }
        .overlay h1 { color: #d4b898; font-size: 42px; }
        .action-btn {
            margin-top: 30px;
            background: #d4b898;
            color: #1e0b36;
            padding: 15px 50px;
            border-radius: 35px;
            font-size: 20px;
            font-weight: bold;
            border: none;
            cursor: pointer;
        }

        .instruction-list {
            text-align: left;
            background: rgba(255,255,255,0.05);
            padding: 25px 40px;
            border-radius: 20px;
            margin: 20px 0;
            max-width: 750px;
        }
        .instruction-list p { margin: 12px 0; white-space: nowrap; } 
    </style>
</head>
<body>

<!-- 引入序列：自动播放 -->
<div id="intro-overlay">
    <img id="img1" class="slide" src="1.jpg" alt="序幕1">
    <img id="img2" class="slide" src="2.jpg" alt="序幕2">
    <img id="img3" class="slide" src="3.jpg" alt="序幕3">
</div>

<div id="container" style="background: linear-gradient(180deg, #1e0b36 0%, #4b1b7d 100%);">
    <div id="mode-selector">
        <div id="btn-companion" class="mode-btn active" onclick="setMode('companion')">✨ 陪伴</div>
        <div id="btn-play" class="mode-btn" onclick="setMode('play')">🍎 投喂</div>
    </div>

    <!-- 操作指南 -->
    <div id="guide-panel">
        <div class="guide-title">✨ 操作指南</div>
        <div class="guide-item">👆 <span>长按：变大膨胀</span></div>
        <div class="guide-item">↔️ <span>左右滑动：跟随移动</span></div>
        <div class="guide-item">🖱️ <span>点击：摇晃身体</span></div>
    </div>

    <!-- 投喂说明 -->
    <div id="start-overlay" class="overlay">
        <h1>准备好了吗？</h1>
        <p style="font-size: 20px; color: #d4b898; margin-bottom: 20px; font-style: italic;">给小八投喂一些水果，让他过的开心一些吧。</p>
        <div class="instruction-list">
            <p>🍎 <strong>目标</strong>：移动鼠标控制卡皮巴拉，吃掉落下的水果得分。</p>
            <p>💜 <strong>警告</strong>：不要碰到紫色的坏果子，它会扣除生命值。</p>
            <p>❤️ <strong>生命</strong>：水果掉落地面也会扣除生命值，保持警惕！</p>
        </div>
        <button class="action-btn" onclick="beginPlay()">现在开始</button>
    </div>

    <div id="game-ui">
        <div class="ui-item">得分: <span id="score-val">0</span></div>
        <div class="ui-item">时间: <span id="timer-val">60</span>s</div>
        <div class="ui-item">生命: <span id="lives-val">❤️❤️❤️</span></div>
    </div>

    <div id="end-overlay" class="overlay">
        <h1 id="over-title">投喂结束</h1>
        <p id="over-score" style="font-size: 28px; color: #d4b898;">最终得分: 0</p>
        <button class="action-btn" onclick="resetGame()">再次投喂</button>
    </div>
</div>

<script>
    let scene, camera, renderer, raycaster;
    let capiGroup, capiBodyMesh, stars;
    let currentMode = 'companion';
    
    let targetPos = new THREE.Vector3();
    let mouseNDC = new THREE.Vector2();
    let capiPos = new THREE.Vector3(0, -5, 0);
    let giantScale = 1.0;
    const MAX_GIANT_SCALE = 5.0;
    let isLongPressing = false;
    let capiShakeImpulse = 0, capiShakeRotation = 0, capiScaleY = 1.0;

    let gameState = 'idle'; 
    let score = 0, timeLeft = 60, lives = 3;
    let fruits = [], particles = [];
    let lastSpawnTime = 0, spawnInterval = 1200, gameTimerInterval;

    const FRUIT_TYPES = [
        { name: 'orange', color: 0xFF7F24, points: 1, scale: 0.45, speedMult: 1 },
        { name: 'watermelon', color: 0x4CAF50, points: 2, scale: 0.65, speedMult: 0.9 },
        { name: 'golden', color: 0xFFD700, points: 5, scale: 0.4, speedMult: 1.5 },
        { name: 'bad', color: 0xFF00FF, points: -1, scale: 0.45, speedMult: 1.1, isBad: true }
    ];

    // --- 启动逻辑 ---

    window.onload = function() {
        init();
        playIntro();
    };

    function playIntro() {
        const slides = [
            document.getElementById('img1'),
            document.getElementById('img2'),
            document.getElementById('img3')
        ];
        
        const firstWait = 2500; // 第一张停留时间
        const otherWait = 1200; // 后续张停留时间
        const transitionTime = 1500; // 缓动过渡时间

        // 步骤1：立即显示第一张
        slides[0].classList.add('active');

        // 步骤2：2500ms后，第一张退出（放大），第二张进入
        setTimeout(() => {
            slides[0].classList.remove('active');
            slides[0].classList.add('exit');
            slides[1].classList.add('active');
            
            // 步骤3：等待切换动画(1500ms) + 静止展示1200ms -> 切到第三张
            setTimeout(() => {
                slides[1].classList.remove('active');
                slides[1].classList.add('exit');
                slides[2].classList.add('active');
                
                // 步骤4：等待切换动画(1500ms) + 静止展示1200ms -> 露出主游戏界面
                setTimeout(() => {
                    slides[2].classList.remove('active');
                    slides[2].classList.add('exit');
                    enterMainGame();
                }, transitionTime + otherWait);

            }, transitionTime + otherWait);

        }, firstWait);
    }

    function enterMainGame() {
        const intro = document.getElementById('intro-overlay');
        const container = document.getElementById('container');
        
        container.style.display = 'block'; 
        intro.style.transition = 'opacity 2.0s cubic-bezier(0.4, 0, 0.2, 1)';
        intro.style.opacity = '0';
        
        setTimeout(() => {
            intro.style.display = 'none';
            onWindowResize(); 
        }, 2000);
    }

    // --- Three.js 核心 ---

    function init() {
        if (renderer) return;
        scene = new THREE.Scene();
        const aspect = window.innerWidth / window.innerHeight;
        camera = new THREE.PerspectiveCamera(40, aspect, 0.1, 1000);
        camera.position.set(0, 2, 22);

        renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.shadowMap.enabled = true;
        document.getElementById('container').appendChild(renderer.domElement);

        scene.add(new THREE.AmbientLight(0xffffff, 0.65)); 
        const topLight = new THREE.DirectionalLight(0xffffff, 0.8);
        topLight.position.set(5, 15, 10);
        topLight.castShadow = true;
        scene.add(topLight);

        createStars();
        createCapybara();
        setMode('companion');

        window.addEventListener('mousemove', onMouseMove);
        window.addEventListener('mousedown', onMouseDown);
        window.addEventListener('mouseup', () => isLongPressing = false);
        window.addEventListener('resize', onWindowResize);
        animate();
    }

    function createStars() {
        const starGeo = new THREE.BufferGeometry();
        const starPos = [];
        for(let i=0; i<3000; i++) starPos.push((Math.random()-0.5)*120, (Math.random()-0.5)*120, (Math.random()-0.5)*120);
        starGeo.setAttribute('position', new THREE.Float32BufferAttribute(starPos, 3));
        stars = new THREE.Points(starGeo, new THREE.PointsMaterial({ color: 0xffffff, size: 0.12, transparent: true, opacity: 0.8 }));
        scene.add(stars);
    }

    function createCapybara() {
        capiGroup = new THREE.Group();
        const bodyMat = new THREE.MeshStandardMaterial({ color: 0xD4B898, roughness: 0.85 });
        const noseMat = new THREE.MeshStandardMaterial({ color: 0x8B5A2B, roughness: 1.0 });
        const blackMat = new THREE.MeshBasicMaterial({ color: 0x222222 });

        // 身体
        capiBodyMesh = new THREE.Mesh(new THREE.SphereGeometry(2, 32, 32), bodyMat);
        capiBodyMesh.scale.set(1.1, 0.9, 1.25);
        capiBodyMesh.position.y = 1.6;
        capiBodyMesh.castShadow = true;
        capiGroup.add(capiBodyMesh);
        
        // 鼻子
        const nose = new THREE.Mesh(new THREE.SphereGeometry(0.5, 24, 24), noseMat);
        nose.scale.set(1.3, 1.15, 0.65); 
        nose.position.set(0, 2.0, 2.2);
        capiGroup.add(nose);

        // 添加细节：鼻孔
        const nW = 0.07, nZ = 2.53;
        const nV = new THREE.Mesh(new THREE.BoxGeometry(nW, 0.35, 0.05), blackMat);
        nV.position.set(0, 2.0, nZ);
        capiGroup.add(nV);
        const nH1 = new THREE.Mesh(new THREE.BoxGeometry(0.32, nW, 0.05), blackMat);
        nH1.position.set(0, 2.15, nZ);
        capiGroup.add(nH1);
        const nH2 = nH1.clone();
        nH2.position.set(0, 1.85, nZ);
        capiGroup.add(nH2);

        // 添加细节：眼睛
        const createEye = (x, rot) => {
            const g = new THREE.Group();
            g.add(new THREE.Mesh(new THREE.BoxGeometry(0.18, 0.06, 0.05), blackMat));
            const lid = new THREE.Mesh(new THREE.BoxGeometry(0.23, 0.08, 0.06), bodyMat);
            lid.position.y = 0.04; 
            g.add(lid);
            g.position.set(x, 2.4, 2.1);
            g.rotation.y = rot;
            return g;
        };
        capiGroup.add(createEye(-0.7, -0.3));
        capiGroup.add(createEye(0.7, 0.3));

        // 添加细节：橘子
        const orangeGroup = new THREE.Group();
        orangeGroup.add(new THREE.Mesh(new THREE.SphereGeometry(0.45, 16, 16), new THREE.MeshStandardMaterial({ color: 0xFF7F24 })));
        const stem = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.04, 0.2), new THREE.MeshStandardMaterial({ color: 0x32CD32 }));
        stem.position.y = 0.5;
        orangeGroup.add(stem);
        const leaf = new THREE.Mesh(new THREE.SphereGeometry(0.15, 12, 12), new THREE.MeshStandardMaterial({ color: 0x32CD32 }));
        leaf.scale.set(1.6, 0.1, 0.8);
        leaf.position.set(0.18, 0.55, 0);
        orangeGroup.add(leaf);
        orangeGroup.position.set(0, 3.5, 1.2);
        capiGroup.add(orangeGroup);
        
        scene.add(capiGroup);
    }

    function setMode(mode) {
        currentMode = mode;
        document.getElementById('btn-companion').className = mode === 'companion' ? "mode-btn active" : "mode-btn";
        document.getElementById('btn-play').className = mode === 'play' ? "mode-btn active" : "mode-btn";
        
        const guide = document.getElementById('guide-panel');
        const startOverlay = document.getElementById('start-overlay');
        const gameUI = document.getElementById('game-ui');

        if(mode === 'play') {
            guide.style.opacity = '0';
            if(gameState !== 'playing' && gameState !== 'over') {
                gameState = 'showing_instructions';
                startOverlay.style.display = 'flex';
            }
        } else {
            guide.style.opacity = '1';
            startOverlay.style.display = 'none';
            gameUI.style.display = 'none';
            stopGame();
        }
    }

    function beginPlay() {
        document.getElementById('start-overlay').style.display = 'none';
        document.getElementById('game-ui').style.display = 'flex';
        startGame();
    }

    function startGame() {
        gameState = 'playing';
        score = 0; lives = 3; timeLeft = 60;
        updateUI();
        gameTimerInterval = setInterval(() => {
            if(timeLeft > 0) { timeLeft--; updateUI(); }
            else { endGame("投喂结束！"); }
        }, 1000);
    }

    function stopGame() { gameState = 'idle'; clearInterval(gameTimerInterval); fruits.forEach(f => scene.remove(f.mesh)); fruits = []; }

    function endGame(reason) {
        gameState = 'over';
        clearInterval(gameTimerInterval);
        document.getElementById('end-overlay').style.display = 'flex';
        document.getElementById('over-title').innerText = reason;
        document.getElementById('over-score').innerText = "最终得分: " + score;
    }

    function resetGame() { document.getElementById('end-overlay').style.display = 'none'; fruits.forEach(f => scene.remove(f.mesh)); fruits = []; startGame(); }

    function updateUI() {
        document.getElementById('score-val').innerText = score;
        document.getElementById('timer-val').innerText = timeLeft;
        document.getElementById('lives-val').innerText = "❤️".repeat(lives);
    }

    function onMouseMove(e) {
        mouseNDC.x = (e.clientX / window.innerWidth) * 2 - 1;
        mouseNDC.y = -(e.clientY / window.innerHeight) * 2 + 1;
        const v = new THREE.Vector3(mouseNDC.x, mouseNDC.y, 0.5).unproject(camera);
        const dir = v.sub(camera.position).normalize();
        targetPos.copy(camera.position).add(dir.multiplyScalar(-camera.position.z / dir.z));
    }

    function onMouseDown() {
        if(currentMode === 'companion' && targetPos.distanceTo(capiPos) < 5) {
            isLongPressing = true;
            capiShakeImpulse = 0.12;
            capiScaleY = 0.85;
        }
    }

    function onWindowResize() {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
    }

    function animate() {
        requestAnimationFrame(animate);
        if(stars) stars.rotation.y += 0.0004;

        giantScale = THREE.MathUtils.lerp(giantScale, (currentMode === 'companion' && isLongPressing) ? MAX_GIANT_SCALE : 1.0, 0.1);
        capiShakeRotation += capiShakeImpulse;
        capiShakeRotation *= 0.9;
        capiShakeImpulse -= capiShakeRotation * 0.1;
        capiScaleY = THREE.MathUtils.lerp(capiScaleY, 1.0, 0.08);

        const followSpeed = (currentMode === 'play' && gameState === 'playing') ? 0.22 : 0.06;
        if (gameState !== 'showing_instructions') capiPos.lerp(targetPos, followSpeed);
        
        capiPos.x = THREE.MathUtils.clamp(capiPos.x, -15, 15);
        capiPos.y = THREE.MathUtils.clamp(capiPos.y, -8, 8);

        if (capiGroup) {
            capiGroup.position.copy(capiPos);
            capiGroup.scale.set(giantScale, giantScale * capiScaleY, giantScale);
            capiGroup.rotation.z = capiShakeRotation;
            capiGroup.rotation.y = THREE.MathUtils.lerp(capiGroup.rotation.y, (targetPos.x - capiPos.x) * 0.4, 0.1);
        }

        if(gameState === 'playing' && currentMode === 'play') {
            if(Date.now() - lastSpawnTime > spawnInterval) { 
                const type = FRUIT_TYPES[Math.floor(Math.random() * FRUIT_TYPES.length)];
                const mesh = new THREE.Mesh(new THREE.SphereGeometry(1, 16, 16), new THREE.MeshStandardMaterial({ color: type.color, emissive: type.color, emissiveIntensity: 0.2 }));
                mesh.position.set((Math.random() - 0.5) * 25, 12, 0);
                mesh.scale.setScalar(type.scale);
                scene.add(mesh);
                fruits.push({ mesh, type, speed: (0.12 + Math.random() * 0.05 + (score * 0.002)) * type.speedMult });
                lastSpawnTime = Date.now(); 
            }
            for(let i = fruits.length-1; i >= 0; i--) {
                const f = fruits[i];
                f.mesh.position.y -= f.speed;
                if(f.mesh.position.distanceTo(new THREE.Vector3(capiPos.x, capiPos.y + 1.6, 0)) < 2.4) {
                    if(f.type.isBad) { lives--; updateUI(); if(lives <= 0) endGame("生命耗尽！"); }
                    else { score += f.type.points; updateUI(); capiScaleY = 1.25; }
                    scene.remove(f.mesh); fruits.splice(i, 1);
                } else if(f.mesh.position.y < -12) {
                    if(!f.type.isBad) { lives--; updateUI(); if(lives <= 0) endGame("漏掉了水果！"); }
                    scene.remove(f.mesh); fruits.splice(i, 1);
                }
            }
        }
        renderer.render(scene, camera);
    }
</script>
</body>
</html>
